[Unit]
Description=Carnine Flutter Frontend
# Not after carnine-backend: the frontend starts beside it and connects once
# it listens (it retries on its own), so the first picture comes about 3 s
# sooner. Wants= still pulls the backend in.
After=systemd-udev-settle.service seatd.service plymouth-start.service
Before=getty@tty1.service
Conflicts=getty@tty1.service
Wants=seatd.service carnine-backend.service

[Service]
Type=notify
NotifyAccess=all
TimeoutStartSec=30s
User=carnine
Group=carnine
SupplementaryGroups=render video input
Environment=CARNINE_EMBEDDED=1
Environment=CARNINE_LOG_PATH=/var/log/carnine/frontend.log
CacheDirectory=carnine-frontend
Environment=HOME=/var/cache/carnine-frontend
ExecStartPre=-+/usr/bin/systemctl stop carnine-getty-fallback.timer
# The boot logo stays up until the first frame: Plymouth lets go of the
# display here but leaves its picture, and plymouth-quit waits for this unit
# (plymouth-quit.service.d/carnine-frontend.conf). Without Plymouth it fails
# quietly.
ExecStartPre=-+/usr/bin/plymouth deactivate
ExecStart=/usr/bin/carnine-frontend
ExecStopPost=-+/usr/bin/systemd-run --on-active=5s --unit=carnine-getty-fallback -- /usr/bin/systemctl start getty@tty1.service
Restart=on-failure
RestartSec=3
# The settings page restarts the frontend by exiting with 75 (AppWindow.restartExitCode).
RestartForceExitStatus=75
SuccessExitStatus=75

[Install]
WantedBy=multi-user.target