#!/bin/sh
set -eu

export CARNINE_EMBEDDED=1

# The bundle ships its own engine and libraries under lib/; the runtime mode is
# fixed by the engine emb bundled, so there is no mode switch here.
BUNDLE_DIR=/opt/carnine/frontend
export LD_LIBRARY_PATH="$BUNDLE_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# -f: take the display's native mode; without it the view keeps its default
# 1920x720 size regardless of the panel. -c: touch only, no pointer to draw.
# CARNINE_HOMESCREEN_ARGS adds embedder flags from a systemd drop-in without a
# rebuild, e.g. "-d --drm-pipeline-depth 2"; it is split on whitespace.
# shellcheck disable=SC2086
exec "$BUNDLE_DIR/homescreen" -b "$BUNDLE_DIR" -f -c ${CARNINE_HOMESCREEN_ARGS:-}
