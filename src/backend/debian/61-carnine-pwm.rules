# sysfs PWM for the gpio group: the backend drives the case fan and the
# display backlight through /sys/class/pwm/pwmchipN (chip "pwm" in
# [[controls]], [display.backlight]). The chip appears with "add"; exporting
# a channel sends "change" on the chip, and the new pwmM directory gets the
# group then.
SUBSYSTEM=="pwm", ACTION=="add|change", RUN+="/bin/sh -c 'chgrp -R gpio /sys%p && chmod -R g+w /sys%p'"
