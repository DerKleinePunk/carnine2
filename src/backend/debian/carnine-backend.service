[Unit]
Description=Carnine Backend
# alsa-restore creates the softvol control PCM; if the backend opened the
# output first, the control would belong to it and amixer could not set it
# (#61).
After=network.target udisks2.service sound.target alsa-restore.service
Wants=network.target
Conflicts=shutdown.target reboot.target halt.target poweroff.target
Before=shutdown.target reboot.target halt.target poweroff.target

[Service]
# The backend sends READY=1 once its gRPC socket listens, so the frontend
# (After=carnine-backend.service) does not start against a missing socket.
Type=notify
User=carnine
Group=carnine
# dialout: the GPS receiver on /dev/gps and the power supply on
# /dev/powersupply (ttyACM/ttyUSB/ttyAMA are root:dialout).
SupplementaryGroups=audio dialout
# Setting the clock from GPS time (navigation.set_system_clock) - no RTC, and
# no NTP in the car.
AmbientCapabilities=CAP_SYS_TIME
RuntimeDirectory=carnine
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/carnine-backend
Environment=CARNINE_CONFIG=/etc/carnine/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target