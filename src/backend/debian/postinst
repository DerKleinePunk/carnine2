#!/bin/sh
set -e

# The backend holds the /RESET of the Technik page's MCP23017 through
# /dev/gpiochip*, which this package's udev rule gives the gpio group. The
# group must exist before udev reloads the rules, or it ignores the name.
if [ "$1" = "configure" ] && id carnine >/dev/null 2>&1; then
    getent group gpio >/dev/null || addgroup --quiet --system gpio
    adduser --quiet carnine gpio
fi

# Give an already plugged-in GPS receiver its /dev/gps link, and the power
# supply's UART its /dev/powersupply link, now instead of at the next replug
# or boot. Fails harmlessly where udev does not run (image build).
if [ "$1" = "configure" ] && command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules 2>/dev/null || true
    udevadm trigger --subsystem-match=tty --action=add 2>/dev/null || true
    udevadm trigger --subsystem-match=gpio --action=change 2>/dev/null || true
fi

# SetExitPassword (#51) writes its drop-in into /etc/carnine/config.d, so the
# carnine group must be able to write there. Older images made the
# directory 0750.
if [ "$1" = "configure" ] && [ -d /etc/carnine/config.d ] && getent group carnine >/dev/null; then
    chgrp carnine /etc/carnine/config.d
    chmod 0770 /etc/carnine/config.d
fi

# The backend drives the switches of the "Technik" page over /dev/i2c-*,
# which the image gives the i2c group; older images left carnine out.
if [ "$1" = "configure" ] && getent group i2c >/dev/null && id carnine >/dev/null 2>&1; then
    adduser --quiet carnine i2c
fi


#DEBHELPER#
