{
    // Verwendet IntelliSense zum Ermitteln möglicher Attribute.
    // Zeigen Sie auf vorhandene Attribute, um die zugehörigen Beschreibungen anzuzeigen.
    // Weitere Informationen finden Sie unter https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter: Run Frontend",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}/src/frontend",
            "args": [
                "-d",
                "linux"
            ]
        },
        {
            "name": "Rust: Debug Backend",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/src/backend/target/debug/carnine-backend",
            "args": [],
            "cwd": "${workspaceFolder}/src/backend",
            "preLaunchTask": "cargo build",
            // The repository config points at the installed-system paths
            // /var/lib/carnine and /var/log/carnine, which an unprivileged
            // dev account can't create. See src/backend/README.md
            // ("Developer start") - do not fix this with sudo instead.
            //
            // Must be the "KEY=VALUE" array form: lldb-dap 19 silently drops
            // "env" when given as a JSON object, even though its schema
            // claims to accept one (verified by scripting the DAP protocol
            // directly against /usr/bin/lldb-dap-19).
            "env": [
                "CARNINE_CONFIG=/tmp/carnine-config.toml",
                "CARNINE_LOG_DIRECTORY=/tmp/carnine-log",
                "CARNINE_DATABASE_PATH=/tmp/carnine-media.sqlite3",
                "CARNINE_AUDIO_BACKEND=pulse",
                "CARNINE_AUDIO_DEVICE=default"
            ]
        }
    ]
}
